# ── Runtime ────────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# ── MongoDB ────────────────────────────────────────────────
# Works with a standalone mongod, a replica set or MongoDB Atlas (mongodb+srv://...).
MONGODB_URI=mongodb://127.0.0.1:27017/learning_center
# Tests run against a separate database. The name MUST end with "_test" (the suite wipes it).
MONGODB_URI_TEST=mongodb://127.0.0.1:27017/learning_center_test

# ── Auth ───────────────────────────────────────────────────
# At least 32 characters. Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-me-with-a-long-random-secret-of-at-least-32-chars
ADMIN_SESSION_HOURS=12
STUDENT_SESSION_DAYS=7
# Set to true when the site is served over HTTPS (production).
COOKIE_SECURE=false

# ── Web / CORS ─────────────────────────────────────────────
# Comma-separated list of allowed browser origins (the Vite dev server by default).
CORS_ORIGIN=http://localhost:5173
# In production the API can also serve the built web app (web/dist).
WEB_DIST_DIR=../web/dist

# ── File storage ───────────────────────────────────────────
# "local" today. The StorageProvider interface (src/storage) lets you add S3 / Cloudinary later.
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads

# ── Seeding (only used by `npm run seed`) ──────────────────
SEED_ADMIN_EMAIL=admin@learningcenter.local
# Leave empty to have a strong random password generated and printed once.
# QUOTE the value if it contains '#' (an unquoted # starts a comment in .env files). Minimum 8 characters.
SEED_ADMIN_PASSWORD=
